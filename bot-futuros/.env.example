# ================== MODO ==================
# papel   = datos reales, operaciones simuladas (saldo virtual)
# testnet = cuenta demo de Binance Futures (Demo Trading)
# real    = plata real (además requiere CONFIRMAR_REAL=SI)
MODO=papel
CONFIRMAR_REAL=NO

# ================== CLAVES (nunca en el código) ==================
BINANCE_API_KEY=
BINANCE_API_SECRET=
OPENROUTER_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ================== MERCADO ==================
SIMBOLO=XRP/USDT:USDT
TIMEFRAME=15m

# ================== RIESGO ==================
# Apalancamiento: tope duro de 3 aunque pongas más
APALANCAMIENTO=3
# % del saldo usado como margen por operación
PORCENTAJE_MARGEN=90
# % de movimiento del precio (con 3x, 3% de precio = ~9% del margen)
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
MAX_OPERACIONES_DIA=5
# Corte automático si la pérdida del día (UTC) llega a este %
PERDIDA_MAX_DIA_PCT=20
# Se apaga si el saldo baja de este valor (USDT)
SALDO_MINIMO=10
# Cada cuántos segundos vigila SL/TP y revisa velas
INTERVALO_VIGILANCIA=30

# ================== MODO PAPEL ==================
SALDO_INICIAL_PAPEL=15
# Comisión por lado en % (0.05 = 0,05%)
COMISION_PCT=0.05

# ================== FILTRO IA (OpenRouter) ==================
IA_MODELO=nex-agi/nex-n2.5-pro:free
IA_MODELO_RESPALDO=nex-agi/nex-n2.5-mini
IA_SCORE_MINIMO=60
IA_MAX_LLAMADAS_DIA=20
IA_MAX_LLAMADAS_SEMANA=80
IA_VELAS=20
IA_TIMEOUT=60

# ================== ALMACENAMIENTO ==================
# Carpeta del volumen persistente (estado, CSV y log)
DATA_DIR=/data
