# Copiá este archivo como .env y completá los valores. NUNCA subas el .env a GitHub.

# Dirección de la base de datos PostgreSQL
DATABASE_URL=postgres://usuario:contraseña@servidor:5432/revenue_engine

# Código que se pide UNA sola vez en la pantalla de configuración inicial.
# Inventá uno largo (ej. 30 letras y números al azar).
SETUP_TOKEN=

# Clave para cifrar credenciales de integraciones (Gmail, Mercado Pago...).
# 32 bytes en base64. Se genera con:  openssl rand -base64 32
# Si se pierde, las credenciales guardadas no se pueden recuperar (habría que reconectarlas).
ENCRYPTION_KEY=

# Solo si el sitio se sirve SIN https (por ejemplo, en una prueba local): poner false.
# COOKIE_SECURE=false

# Clave de la API de Claude (console.anthropic.com). Sin ella, los diagnósticos se hacen igual pero sin resumen de IA.
ANTHROPIC_API_KEY=

# Opcional: clave de Google PageSpeed Insights (gratis, en Google Cloud Console → APIs → PageSpeed Insights API).
# Sin ella los diagnósticos no incluyen la nota de velocidad de Google.
PAGESPEED_API_KEY=
