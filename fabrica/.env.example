# ===== MODO =====
# papel   = todo simulado con precios reales (no necesita claves de Binance)
# testnet = los titulares operan en la cuenta Demo de Binance (plata de mentira)
# real    = plata real: además necesita LIVE_TRADING=true y confirmar por Telegram con /confirmar_real
MODO=papel
LIVE_TRADING=false

# ===== CLAVES (nunca en el código) =====
# Para testnet: claves de Demo Trading. Para real: clave SIN permiso de retiro.
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== CARPETAS (dentro del volumen persistente) =====
FABRICA_DATOS=/data/datos
FABRICA_RESULTADOS=/data/resultados
FABRICA_VIVO=/data/vivo
