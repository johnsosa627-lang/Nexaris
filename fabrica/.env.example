# ===== MODO =====
# papel   = todo simulado con precios reales (no necesita claves de Binance)
# testnet = los titulares operan en la cuenta Demo del exchange (plata de mentira)
# real    = plata real: además necesita LIVE_TRADING=true y confirmar por Telegram con /confirmar_real
MODO=papel
LIVE_TRADING=false

# ===== EXCHANGE =====
# binance = normal (lo de siempre). bybit = cuenta de FONDEO (ej. HyroTrader, corre el bot en Bybit).
# Dejar en binance salvo que estemos haciendo un examen de fondeo. Las claves van en BINANCE_API_KEY/SECRET
# (sirven para los dos; el nombre quedó por historia). En bybit, MODO=testnet usa la cuenta Demo de Bybit.
EXCHANGE=binance

# ===== CLAVES (nunca en el código) =====
# Para testnet: claves de Demo Trading. Para real: clave SIN permiso de retiro.
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== REAL PARCIAL (opcional) =====
# Con MODO=testnet, SOLO los bots de config.yaml (real_parcial.bots) operan con plata real usando estas claves
# de la cuenta REAL (solo operar futuros, SIN retiros, IP restringida). Necesita LIVE_TRADING=true y /confirmar_real.
BINANCE_REAL_API_KEY=
BINANCE_REAL_API_SECRET=

# ===== CARPETAS (dentro del volumen persistente) =====
FABRICA_DATOS=/data/datos
FABRICA_RESULTADOS=/data/resultados
FABRICA_VIVO=/data/vivo
