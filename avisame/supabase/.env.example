# Secretos de las funciones del servidor. Se cargan con:
#   supabase secrets set --env-file supabase/.env
# (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY ya los pone Supabase.)
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=clave-secreta-del-webhook
APP_URL=https://avisame.uy
# Opcional: token de acceso de Expo si activás "Enhanced security for push"
EXPO_ACCESS_TOKEN=
