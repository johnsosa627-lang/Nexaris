# Copiá este archivo como .env.local y completá los valores.
# Sin EXPO_PUBLIC_SUPABASE_URL la app arranca en modo VISTA PREVIA (datos de ejemplo).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Forzar la vista previa aunque haya credenciales (1 = sí)
EXPO_PUBLIC_VISTA_PREVIA=0

# Datos legales que aparecen en la política de privacidad y los términos
EXPO_PUBLIC_RESPONSABLE=Nombre o razón social
EXPO_PUBLIC_EMAIL_CONTACTO=contacto@tudominio.uy
EXPO_PUBLIC_DOMICILIO=Calle 1234, Montevideo, Uruguay
